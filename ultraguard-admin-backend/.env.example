# Prisma / Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ultraguard?schema=public"
# For quick local-only dev without Postgres installed, switch prisma/schema.prisma's
# datasource provider to "sqlite" and use: DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# OTP
OTP_EXPIRY_MINUTES=5
# When true, OTP codes are returned in the API response body for local/dev testing
# because no SMS provider has been contracted yet (see docs/HARDWARE_INTEGRATION_PROTOCOL.md).
OTP_DEV_MODE=true

# Gate hardware shared secret (placeholder until real intercom hardware protocol is finalized)
GATE_API_KEY="dev-gate-shared-secret"

# Seed admin account
SEED_ADMIN_EMAIL="admin@ultraguard.co.za"
SEED_ADMIN_PASSWORD="ChangeMe123!"
