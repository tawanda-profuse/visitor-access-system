# Prisma / Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ultraguard?schema=public"
# For quick local-only dev without Postgres installed, switch prisma/schema.prisma's
# datasource provider to "sqlite" and use: DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Phone numbers
# Default region (ISO 3166-1 alpha-2) used to interpret phone numbers entered without a
# country code, e.g. "0778822943" -> "+263778822943" when set to "ZW".
DEFAULT_PHONE_COUNTRY="ZW"

# Gate hardware shared secret (placeholder until real intercom hardware protocol is finalized)
GATE_API_KEY="dev-gate-shared-secret"

# Base URL — the single source for every link built into emails (invites, password resets).
# Set this to your real deployed URL in production.
BASE_URL="http://localhost:3000"

# Public download URL for the latest Android resident-app build, included in resident
# invitation emails. Published automatically by .github/workflows/build-android-apk.yml
# to a fixed S3 key on every merge to main — see ultraguard-resident-app/infra/aws/ for
# the one-time bucket/IAM setup. Leave empty to omit the download link from the email.
ANDROID_APK_URL=""

# Email (Nodemailer via Brevo SMTP relay)
#
# Brevo (https://www.brevo.com) offers a free-forever tier of 300 emails/day and works
# as a drop-in Nodemailer SMTP transport with no domain verification required to start:
#   1. Sign up for a free Brevo account.
#   2. Go to Settings -> SMTP & API -> SMTP tab, and generate a new SMTP key.
#   3. Set SMTP_USER to your Brevo account's login email, and SMTP_PASS to the generated key.
#   4. (Recommended) Verify a sender domain/address under Senders, Domains & Dedicated IPs
#      for better deliverability — otherwise emails may land in spam.
#
# Leave SMTP_HOST empty to skip real sending — emails are logged to the console instead,
# so local development and testing never depend on having SMTP credentials configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ultra-Guard Security & Fire <no-reply@ultraguard.co.za>"

# Developer-only logging. Defaults to on outside production (NODE_ENV !== "production");
# set explicitly to "true"/"false" to override.
DEV_LOGS="true"

# Seed admin account
SEED_ADMIN_EMAIL="admin@ultraguard.co.za"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_RESIDENT_PASSWORD="ChangeMe123!"
